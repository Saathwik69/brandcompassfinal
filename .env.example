PORT=3000
HOST=127.0.0.1
# On a hosting service use HOST=0.0.0.0 and its supplied PORT.
# Optional persistent database path (set to a mounted disk on the host):
# DB_PATH=/var/data/brandcompass.sqlite
# At-rest encryption key for workspace state (AES-256-GCM) and HMAC audit signing key:
# DATA_ENCRYPTION_KEY=your_32_char_encryption_secret
# AUDIT_SIGNING_KEY=your_hmac_audit_signing_secret
# Optional, opt-in grounded language review via OpenAI Responses API:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional self-hosted LLM endpoint (Ollama / vLLM / LocalAI) or 'builtin' local advisory engine:
# SELF_HOSTED_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# SELF_HOSTED_MODEL=llama3.2
# Allow visitors to create a new organisation. Disable for a controlled deployment.
ALLOW_SIGNUP=true
